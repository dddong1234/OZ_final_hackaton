# 원본 / 가공 데이터
# 운영 공지: 대회 제공 데이터셋은 GitHub 에 올리지 않는다.
# data/ dataset/ 전체를 제외하고 폴더 구조 유지용 .gitkeep 만 남긴다.
data/**
!data/**/
!data/**/.gitkeep
dataset/**
!dataset/**/
!dataset/**/.gitkeep

# 대회 데이터 파일명 방어 (다른 경로에 두더라도)
**/train.csv
**/test.csv
**/sample_submission.csv

# 공용 실험 산출물
outputs/*
!outputs/.gitkeep

# 팀원별 로컬 EDA 산출물
experiments/member_*/notebooks/eda_summary.json
experiments/member_*/notebooks/class_distribution.csv

# 팀원별 실험 산출물: 폴더 깊이와 무관하게 설명과 지표만 공유
experiments/member_*/**/results/**
!experiments/member_*/**/results/**/
!experiments/member_*/**/results/**/README.md
!experiments/member_*/**/results/**/metrics.json

# 공통 이름을 사용하는 예측 산출물
**/submission*.csv
**/test_probabilities.*
**/oof_probabilities.*

# 모델 / 체크포인트 / 직렬화 파일
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.joblib
*.onnx
*.h5
*.hdf5
*.keras
*.safetensors

# ML 실험 추적 도구
wandb/
mlruns/
mlartifacts/
lightning_logs/
catboost_info/
runs/

# 프로파일링
*.prof
*.lprof
*.flamegraph

# iljun workspace (member_d 에서 rename, 2026-07-31)
experiments/iljun/notebooks/eda_summary.json
